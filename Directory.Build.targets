<Project>
  <!--
    Every official module must share the host SDK contract instead of carrying a private copy.
    A second StarPie.Plugin.Abstractions.dll causes type-identity split and makes casts fail.
  -->
  <Target Name="ValidateOfficialPluginOutput" AfterTargets="Build">
    <Error
      Condition="Exists('$(TargetDir)StarPie.Plugin.Abstractions.dll')"
      Text="StarPie.Plugin.Abstractions.dll must not be copied into an official plugin output: $(TargetDir)" />
  </Target>
</Project>
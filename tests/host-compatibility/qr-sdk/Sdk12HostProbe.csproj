<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>QrSdk12HostProbe</AssemblyName>
    <IsPluginRegressionTest>true</IsPluginRegressionTest>
    <BaseOutputPath>$(CompatibilityOutputRoot)/probe12/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Sdk12HostProbe.cs" />
    <ProjectReference Include="$(CompatibilitySdkProject)" />
    <Reference Include="zxing"><HintPath>$(QrPluginOutput)/zxing.dll</HintPath></Reference>
  </ItemGroup>
</Project>

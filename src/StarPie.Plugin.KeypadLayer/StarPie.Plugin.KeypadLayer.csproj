<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StarPie 官方在线插件：按键映射 (StarPie.Plugin.KeypadLayer)
    ========================================================================
    通过轮盘开启或关闭自定义按键映射，将物理按键映射为目标按键；
    支持可视化配置，并在切换应用或长按 Esc 时安全释放。默认提供左手数字小键盘预设。

    遵循官方模块规范：
      1. 继承 Directory.Build.props 统一编译参数；
      2. 引用 StarPie.Plugin.Abstractions，设置 Private=false；
      3. 零 NuGet 依赖，严禁携带主程序 StarPie.dll 或 Abstractions 产物。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>

    <AssemblyName>StarPie.Plugin.KeypadLayer</AssemblyName>
    <RootNamespace>StarPie.Plugin.KeypadLayer</RootNamespace>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>StarPie 按键映射</Product>
    <Company>StarPie Studio</Company>
    <Description>StarPie 官方插件：通过轮盘开启或关闭自定义按键映射，将物理按键映射为目标按键；支持可视化配置，并在切换应用或长按 Esc 时安全释放。默认提供左手数字小键盘预设。</Description>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false：不把 SDK 程序集复制到输出目录。生产物里必须只有这一枚 dll。 -->
    <ProjectReference Include="..\StarPie.Plugin.Abstractions\StarPie.Plugin.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="StarPiePluginId" Value="starpie.plugin.keypadlayer" />
    <AssemblyMetadata Include="StarPiePluginName" Value="按键映射" />
    <AssemblyMetadata Include="StarPiePluginCapabilities" Value="InputRemapping" />
    <AssemblyMetadata Include="StarPiePluginLicense" Value="MIT" />
    <AssemblyMetadata Include="StarPiePluginHomepage" Value="https://github.com/Star-Pie/StarPie" />
    <AssemblyMetadata Include="StarPiePluginApiVersion" Value="1.7" />
    <AssemblyMetadata Include="StarPiePluginMinHostVersion" Value="1.8.1-beta.1" />
  </ItemGroup>

</Project>

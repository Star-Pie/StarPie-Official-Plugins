<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StarPie 随包动作包：平铺窗口
    ==================================================================
    与 samples/ 那种演示插件不同，它与 StarPie.Plugin.Abstractions 一样
    属于「主程序功能的物理拆分」：认领一个顶层动作类型（见下面的
    StarPiePluginTypeClaims），用户在配置里写的 Type="Tile" 今后由本程序集执行。

    **为什么一个动作单独占一个包**：拆包的唯一正当理由是「用户会想单独关掉它」。
    这一批（平铺 / 置顶 / 移到下一屏 / 透明度 / 切换窗口）的粒度再做细一档 ——
    用户完全可能只想关掉「窗口透明度」，而继续用「平铺窗口」；
    从前它们同属窗口动作包，要关就得五个一起关。
    代价是包数变多（每个包一次 PE 元数据扫描、一条登记条目），
    换来的是停用粒度精确到动作。

    三条与社区插件完全相同的约束（照抄自 samples/HelloAction）：
      1. TargetFramework 不得高于宿主；
      2. ProjectReference 必须 Private=false —— 否则产物里会多出一份
         StarPie.Plugin.Abstractions.dll，两份类型身份会让所有强转失败；
      3. 只能引用 SDK 与 BCL，**绝不引用主程序 StarPie.dll**。

    第 3 条对它是硬约束：这个包存在的意义就是证明「宿主自己的动作真的能靠 SDK
    独立跑起来」。窗口控制是很好的检验 —— 宿主只通过 IHostWindowService 给出能力，
    连窗体的布局码清单都是运行时从服务读的，插件里没有一处 P/Invoke。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>

    <AssemblyName>StarPie.Plugin.Tile</AssemblyName>
    <RootNamespace>StarPie.Plugin.Tile</RootNamespace>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>StarPie 平铺窗口</Product>
    <Company>StarPie Studio</Company>
    <Description>随 StarPie 分发的内置动作：平铺窗口。可在「插件」页单独停用。</Description>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false：不把 SDK 程序集复制到输出目录。生产物里必须只有这一枚 dll。 -->
    <ProjectReference Include="..\..\sdk\StarPie.Plugin.Abstractions\StarPie.Plugin.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!--
    程序集元数据。随包插件走「裸 DLL」分发形态（来源区约定是扁平且只放 .dll），
    所以这些特性就是它的全部自描述信息，宿主靠静态读 PE 元数据识别它，不执行任何代码。
  -->
  <ItemGroup>
    <AssemblyMetadata Include="StarPiePluginId" Value="starpie.builtin.tile" />
    <!-- 插件名与动作显示名刻意一致：用户停用的是「平铺窗口」这个动作，
         插件页里那一行若叫别的名字，他还得自己建立对应关系。 -->
    <AssemblyMetadata Include="StarPiePluginName" Value="平铺窗口" />
    <AssemblyMetadata Include="StarPiePluginCapabilities" Value="WindowControl" />
    <AssemblyMetadata Include="StarPiePluginLicense" Value="MIT" />
    <AssemblyMetadata Include="StarPiePluginHomepage" Value="https://github.com/SoftBlack42/StarPie" />

    <!--
      顶层动作类型认领。格式：分号分隔的「用户配置里的 Type 名=本插件内的贡献点短 ID」。
      右侧的短 ID 必须与 TilePlugin.Initialize 里注册的 Descriptor.Id 逐字一致 ——
      对不上的表现是「认领条目存在、指向的贡献点却不存在」，按下去只得到一句
      「插件没提供这个动作」，且不会有任何报错提示是清单写错了。自检 [3i] 守这条。

      单动作包只认领一项。**别名必须与主类型同包**（WebUrl/Url、Folder/OpenFolder、
      Ocr/ScreenOcr 那三对），否则会出现「同一个动作在两种写法下由不同插件执行」，
      停用其中一个只失效一半配置。本类型从第一版起就只叫 Tile，没有别名。
    -->
    <AssemblyMetadata Include="StarPiePluginTypeClaims" Value="Tile=tile" />
  </ItemGroup>

</Project>

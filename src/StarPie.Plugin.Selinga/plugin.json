{
  "schemaVersion": 1,
  "id": "starpie.plugin.selinga",
  "name": "识图翻译",
  "description": "框选屏幕区域，识别其中文字并译成目标语言，译文贴在原位显示。再次触发可重新框选。",
  "author": "Sunse666",
  "homepage": "https://github.com/Sunse666/Selinga",
  "license": "MIT",
  "version": "0.5.0",
  "apiVersion": "1.14",
  "minHostVersion": "2.0.0",
  "maxHostVersion": null,
  "targetFramework": "net8.0-windows",
  "platform": "win-x64",
  "runtime": "process",
  "command": [
    "bin/selinga.exe",
    "--starpie-action", "{action}",
    "--target-lang", "{languageCode}"
  ],
  "actions": [
    {
      "id": "translate",
      "displayName": "识图翻译",
      "description": "框选后识别并翻译，译文贴回原位",
      "category": "效率工具"
    },
    {
      "id": "settings",
      "displayName": "识图翻译设置",
      "description": "打开配置文件（目标语言、翻译链、视觉模型端点）",
      "category": "效率工具"
    }
  ],
  "capabilities": [
    "ScreenCapture",
    "Ui"
  ],
  "contributions": {
    "actions": true,
    "icons": false,
    "i18n": false
  },
  "dependencies": [],
  "icon": null,
  "tags": [
    "official",
    "ocr",
    "translate"
  ],
  "features": [
    {
      "id": "translate",
      "name": "识图翻译",
      "description": "框选屏幕区域，识别并翻成目标语言",
      "category": "效率工具"
    }
  ]
}

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StarPie 随包动作包：截屏识字 (OCR)
    ==================================================================
    单动作包 —— 认领两个顶层动作类型（见下面的 StarPiePluginTypeClaims）：
    Ocr 与它的历史别名 ScreenOcr。**别名必须与主类型同包** ——
    分到两个包会出现「同一个动作在两种写法下由不同插件执行」，
    停用其中一个只失效一半配置，而用户完全看不出另一半为什么还活着。

    **为什么一个动作单独占一个包**：拆包的唯一正当理由是「用户会想单独关掉它」。
    这个动作的后果是**读取屏幕内容**，是这批动作里隐私敏感度最高的一个 ——
    想单独关掉它的用户不在少数，而它从前与「系统控制」同属一个包。

    三条与社区插件完全相同的约束（照抄自 samples/HelloAction）：
      1. TargetFramework 不得高于宿主；
      2. ProjectReference 必须 Private=false —— 否则产物里会多出一份
         StarPie.Plugin.Abstractions.dll，两份类型身份会让所有强转失败；
      3. 只能引用 SDK 与 BCL，**绝不引用主程序 StarPie.dll**。

    第 3 条对这个包尤其有意义：截图与 OCR 引擎全在宿主侧
    （OcrManager / Windows.Graphics.Capture / 系统 OCR），插件里一行 P/Invoke 都没有，
    它做的只是「请宿主发起一次框选识别」。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>

    <AssemblyName>StarPie.Plugin.Ocr</AssemblyName>
    <RootNamespace>StarPie.Plugin.Ocr</RootNamespace>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>StarPie 截屏识字</Product>
    <Company>StarPie Studio</Company>
    <Description>随 StarPie 分发的内置动作：框选屏幕区域并识别其中的文字。可在「插件」页单独停用。</Description>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false：不把 SDK 程序集复制到输出目录。生产物里必须只有这一枚 dll。 -->
    <ProjectReference Include="..\StarPie.Plugin.Abstractions\StarPie.Plugin.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="StarPiePluginId" Value="starpie.builtin.ocr" />
    <!-- 插件名与动作显示名刻意一致：用户停用的是这个动作，插件页里那一行若叫别的名字，他还得自己建立对应关系。 -->
    <AssemblyMetadata Include="StarPiePluginName" Value="截屏识字 (OCR)" />
    <!--
      这一项能力有真实强制点：执行走 IHostScreenCaptureService.CaptureAndRecognize，
      未声明 ScreenCapture 会被直接拒绝。它单独成项而不是并进 Ui，
      正是因为「它会看到我的屏幕」这件事必须在安装确认页上被明确说出来。
    -->
    <AssemblyMetadata Include="StarPiePluginCapabilities" Value="ScreenCapture" />
    <AssemblyMetadata Include="StarPiePluginLicense" Value="MIT" />
    <AssemblyMetadata Include="StarPiePluginHomepage" Value="https://github.com/SoftBlack42/StarPie" />

    <!-- 右侧的短 ID 必须与 OcrPlugin.Initialize 里注册的 Descriptor.Id 逐字一致，自检 [3i] 守这条。 -->
    <AssemblyMetadata Include="StarPiePluginTypeClaims" Value="Ocr=ocr;ScreenOcr=ocr" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StarPie 官方插件原型：桌宠（Desktop Pet）
    ==================================================================
    首版原型插件：
    在屏幕上呈现透明桌宠窗口，左键轻点呼出宿主轮盘，拖动可移动位置。
    通过宿主声明式设置页配置本地素材目录、尺寸与动画开关。

    硬约束：
    1. TargetFramework 不得高于宿主（net8.0-windows）。
    2. ProjectReference 必须设 Private=false，避免类型身份分裂。
    3. 仅引用 StarPie.Plugin.Abstractions 与 BCL（含 WPF 框架引用）。
    4. 不引用 StarPie.dll，零 NuGet 依赖。
    5. 声明 Ui 与 Wheel 能力，apiVersion 为 1.11。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>

    <AssemblyName>StarPie.Plugin.DesktopPet</AssemblyName>
    <RootNamespace>StarPie.Plugin.DesktopPet</RootNamespace>

    <Version>0.1.6</Version>
    <AssemblyVersion>0.1.6.0</AssemblyVersion>
    <FileVersion>0.1.6.0</FileVersion>
    <Product>StarPie 桌宠插件</Product>
    <Company>SoftBlack42</Company>
    <Description>屏幕上的桌宠原型，轻点呼出轮盘，支持拖动与自定义素材。</Description>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DesktopPetTests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false 保证输出目录不携带 StarPie.Plugin.Abstractions.dll -->
    <ProjectReference Include="..\..\sdk\StarPie.Plugin.Abstractions\StarPie.Plugin.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- 程序集元数据：裸 DLL 分发与安装时也能被完整识别 -->
  <ItemGroup>
    <AssemblyMetadata Include="StarPiePluginId" Value="starpie.plugin.desktoppet" />
    <AssemblyMetadata Include="StarPiePluginName" Value="桌宠" />
    <AssemblyMetadata Include="StarPiePluginCapabilities" Value="Ui;Wheel" />
    <AssemblyMetadata Include="StarPiePluginApiVersion" Value="1.11" />
    <AssemblyMetadata Include="StarPiePluginMinHostVersion" Value="1.8.0-beta.7" />
    <AssemblyMetadata Include="StarPiePluginLicense" Value="MIT" />
    <AssemblyMetadata Include="StarPiePluginHomepage" Value="https://github.com/Star-Pie/StarPie-Official-Plugins" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

{
  "schemaVersion": 1,
  "id": "starpie.plugin.sound",
  "name": "轮盘音效",
  "description": "通过交互事件提供轮盘音效；在插件设置页选择各事件的自定义 WAV，管理静音、音量和主题。需要用户安装、启用并按需开启预加载。",
  "author": "StarPie Studio",
  "homepage": "https://github.com/Star-Pie/StarPie-Official-Plugins",
  "license": "MIT",
  "version": "1.0.0",
  "apiVersion": "1.10",
  "minHostVersion": "1.8.0-beta.7",
  "maxHostVersion": null,
  "targetFramework": "net8.0-windows",
  "platform": "win-x64",
  "assembly": "StarPie.Plugin.Sound.dll",
  "entryType": "StarPie.Plugin.Sound.SoundPlugin",
  "capabilities": [
    "FileSystem"
  ],
  "claimedTypes": [],
  "contributions": {
    "actions": false,
    "icons": true,
    "i18n": true
  },
  "dependencies": [],
  "tags": [
    "official",
    "sound",
    "interaction"
  ],
  "features": [
    {
      "id": "feedback",
      "name": "轮盘反馈",
      "description": "观察轮盘语义，不改变动作或导航。",
      "category": "交互反馈"
    },
    {
      "id": "custom-wav",
      "name": "自定义音效文件",
      "description": "在设置页为呈现、选择、展开、确认和取消选择 WAV；主题需设为自定义，留空沿用所选方案。",
      "category": "音效"
    }
  ],
  "release": {
    "enabled": true
  }
}

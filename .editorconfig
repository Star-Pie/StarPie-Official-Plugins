root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.ps1]
indent_style = space
indent_size = 2
end_of_line = crlf

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.cs]
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all